{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evento.schema.json",
  "title": "Evento di vita",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titolo", "categoria", "descrizione", "fasi"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "titolo": { "type": "string" },
    "categoria": { "enum": ["lavoro", "casa", "famiglia", "mobilita", "patrimonio", "previdenza", "salute", "cittadinanza", "fisco", "lutto"] },
    "descrizione": { "type": "string" },
    "fasi": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "prima": { "$ref": "#/definitions/elenco" },
        "durante": { "$ref": "#/definitions/elenco" },
        "dopo": { "$ref": "#/definitions/elenco" }
      }
    },
    "date": {
      "type": "array",
      "minItems": 1,
      "description": "Date che l'evento chiede all'utente per calcolare le scadenze delle sue voci (campo `dal`).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domanda", "riferimento"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "domanda": { "type": "string", "description": "Etichetta del campo, es. «Data di nascita»." },
          "riferimento": { "type": "string", "description": "Come si legge dopo «entro tot giorni», es. «dalla nascita»." }
        }
      }
    }
  },
  "definitions": {
    "elenco": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  }
}
