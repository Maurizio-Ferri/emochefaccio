{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voce.schema.json",
  "title": "Voce: un singolo dovere o diritto",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titolo", "tipo", "descrizione", "ente", "livello_territoriale", "fonti", "maturita"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "titolo": { "type": "string", "minLength": 3, "maxLength": 90 },
    "tipo": { "enum": ["dovere", "diritto"] },
    "descrizione": { "type": "string", "minLength": 10, "description": "1-2 frasi in linguaggio semplice. Al livello 1 niente importi, soglie o percentuali." },
    "passi": {
      "type": "array",
      "minItems": 1,
      "description": "Solo livello 2: cosa fare, in ordine. Come nella descrizione, in bozza niente numeri.",
      "items": { "type": "string", "minLength": 5 }
    },
    "ente": { "type": "string" },
    "livello_territoriale": { "enum": ["nazionale", "regionale", "comunale"] },
    "quando": {
      "type": "array",
      "description": "Flag del profilo che devono essere tutti veri perché la voce compaia in 'La mia situazione'. Se assente, la voce compare solo dentro gli eventi.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "fonti": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fonte" }
    },
    "scadenze": {
      "type": "array",
      "minItems": 1,
      "description": "Solo livello 2. Qui giorni e date sono ammessi anche in bozza: il sito li mostra solo quando la voce non è più in bozza.",
      "items": { "$ref": "#/definitions/scadenza" }
    },
    "controllato_il": { "type": ["string", "null"], "format": "date", "description": "Data del controllo automatico (AI) sulle fonti." },
    "verificato_il": { "type": ["string", "null"], "format": "date", "description": "Data della verifica fatta da una persona." },
    "maturita": { "enum": ["bozza", "controllata", "verificata", "completa"] }
  },
  "allOf": [
    {
      "if": { "properties": { "maturita": { "const": "controllata" } } },
      "then": { "required": ["controllato_il"], "properties": { "controllato_il": { "type": "string" } } }
    },
    {
      "if": { "properties": { "maturita": { "enum": ["verificata", "completa"] } } },
      "then": { "required": ["verificato_il"], "properties": { "verificato_il": { "type": "string" } } }
    }
  ],
  "definitions": {
    "fonte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titolo", "url"],
      "properties": {
        "titolo": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "scadenza": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titolo", "fonte"],
      "properties": {
        "titolo": { "type": "string", "minLength": 3 },
        "ogni_anno": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$", "description": "Scadenza fissa ogni anno, MM-GG." },
        "dal": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Id della data, chiesta dall'evento, da cui si conta (es. nascita, rogito)." },
        "giorni": { "type": "integer", "minimum": 1 },
        "mesi": { "type": "integer", "minimum": 1 },
        "fonte": { "$ref": "#/definitions/fonte" }
      },
      "oneOf": [
        { "required": ["ogni_anno"], "not": { "anyOf": [{ "required": ["dal"] }, { "required": ["giorni"] }, { "required": ["mesi"] }] } },
        { "required": ["dal"], "not": { "required": ["ogni_anno"] }, "oneOf": [{ "required": ["giorni"] }, { "required": ["mesi"] }] }
      ]
    }
  }
}
