{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "profilo.schema.json",
  "title": "Domande del profilo e regioni",
  "type": "object",
  "additionalProperties": false,
  "required": ["domande", "regioni"],
  "properties": {
    "domande": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "testo"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "testo": { "type": "string" },
          "aiuto": { "type": "string" },
          "mostra_se": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "regioni": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome"],
        "properties": { "id": { "type": "string" }, "nome": { "type": "string" } }
      }
    }
  }
}
