{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "override.schema.json",
  "title": "Override locale (regione o comune)",
  "type": "object",
  "additionalProperties": false,
  "required": ["livello", "id", "nome", "override"],
  "properties": {
    "livello": { "enum": ["regione", "comune"] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "nome": { "type": "string" },
    "regione": { "type": "string", "description": "Obbligatorio per i comuni: id della regione." },
    "override": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["voce"],
        "properties": {
          "voce": { "type": "string" },
          "ente": { "type": "string" },
          "nota_locale": { "type": "string", "description": "Cosa cambia qui rispetto alla regola generale." },
          "fonti": { "type": "array", "items": { "$ref": "voce.schema.json#/definitions/fonte" } },
          "controllato_il": { "type": ["string", "null"], "format": "date", "description": "Data del controllo automatico (AI) sulle fonti." },
          "verificato_il": { "type": ["string", "null"], "format": "date" }
        }
      }
    }
  },
  "if": { "properties": { "livello": { "const": "comune" } } },
  "then": { "required": ["regione"] }
}
