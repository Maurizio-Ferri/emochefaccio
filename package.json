{
  "name": "emochefaccio",
  "private": true,
  "version": "0.1.0",
  "description": "Cosa devi fare e cosa puoi fare nei rapporti con lo Stato italiano.",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "validate": "node scripts/build-content.mjs --check",
    "comuni": "node scripts/aggiorna-comuni.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run content && vitest run"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "js-yaml": "4.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
